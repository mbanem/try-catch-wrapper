{
  "name": "try-catch-wrapper",
  "displayName": "try-catch-wrapper",
  "description": "wraps selected code in try/catch block with fun",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/mbanem/try-catch-wrapper.git"
  },
  "license": "MIT",
  "publisher": "mbanem",
  "contributes": {
    "commands": [
      {
        "command": "try-catch-wrapper.extension",
        "title": "Try Catch Wrapper"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package-x",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package-x": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "package": "vsce package",
    "ix": "pnpm run package && code --install-extension try-catch-wrapper-$(jq -r '.version' package.json).vsix --force"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "@dprint/formatter": "^0.6.0",
    "@types/node": "20.x",
    "@types/vscode": "^1.140.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "esbuild": "^0.25.3",
    "eslint": "^10.13.0",
    "npm-run-all": "^4.1.5"
  }
}
